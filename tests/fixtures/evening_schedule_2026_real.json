  "sql_schedule": "SELECT g.year, g.kind_code, g.game_sno, g.game_date, (SELECT r.raw_payload->>'PreExeDate' FROM cpbl.game_schedule_status_revisions r WHERE r.year=g.year AND r.kind_code=g.kind_code AND r.game_sno=g.game_sno AND r.raw_present_status=1 AND r.raw_pre_exe_date=g.game_date ORDER BY r.last_seen_at DESC, r.fetched_at DESC LIMIT 1) AS starts_at FROM cpbl.games g WHERE g.year=2026 AND g.kind_code IN ('A','D','E','C') AND g.game_date IN ('2026-09-07','2026-09-23','2026-09-27','2026-10-04','2026-10-12','2026-10-15','2026-10-21','2026-10-22') ORDER BY 4,2,3",
  "sql_revisions": "SELECT kind_code, game_sno, raw_present_status, raw_game_result, raw_game_date, raw_pre_exe_date, raw_payload->>'PreExeDate', raw_payload->>'HomeScore', raw_payload->>'VisitingScore', game_season_code, fetched_at, last_seen_at, seen_count, payload_hash FROM cpbl.game_schedule_status_revisions WHERE year=2026 AND (kind,sno) ∈ {A304,A306,E4,…} ORDER BY 1,2,fetched_at（SET LOCAL TIME ZONE 'Asia/Taipei'）；cpbl.game_completion_evidence 三場皆 0 列",
  "shell_note": "schedule_files 的外殼（date／generated_at）依 #365 規劃 3 §5.1 的介面假設合成（#364 尚未定稿）；games[] 的場次、日期、開賽時刻是本機真實值。WP1 定稿後只改外殼，不改場次內容。",
  "a_partial_note": "A304／A306 的 in_progress_1950 是 2026-09-07 19:50:53（台北）www 在賽中回的真實修訂列（GameResult=''、PresentStatus=1、部分比分）；final_0908 是隔日 10:10 每日鏈抓到的官方 final 列。cpbl.games 現值是終場比分，(h) 必須用 in_progress_1950 的比分重建賽中狀態。"
