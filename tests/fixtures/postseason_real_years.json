  "sql_standings_computed": "SELECT seg, tc, sum(w)::int w, sum(l)::int l, sum(t)::int t FROM (\n  SELECT g.game_season_code seg, g.home_team_code tc,\n         (g.home_score>g.away_score)::int w, (g.home_score<g.away_score)::int l, (g.home_score=g.away_score)::int t\n  FROM cpbl.games g WHERE g.year=%(year)s AND g.kind_code='A' AND {DONE}\n  UNION ALL\n  SELECT g.game_season_code, g.away_team_code,\n         (g.away_score>g.home_score)::int, (g.away_score<g.home_score)::int, (g.home_score=g.away_score)::int\n  FROM cpbl.games g WHERE g.year=%(year)s AND g.kind_code='A' AND {DONE}\n) x GROUP BY seg, tc ORDER BY seg, tc",
  "sql_standings_official": "SELECT season_code, team_code, w, l, t FROM cpbl.team_standings WHERE year=%s AND kind_code='A' ORDER BY season_code, rank, team_code",
  "sql_games": "SELECT g.kind_code, g.game_sno, g.game_season_code, g.game_date::text, g.away_team_code, g.home_team_code,\n  g.away_score, g.home_score, COALESCE({DONE}, FALSE) completed\n  FROM cpbl.games g WHERE g.year=%(year)s AND g.kind_code IN ('E','C') ORDER BY g.game_date, g.kind_code, g.game_sno",
