  "denominator_invariant": {
    "all_pass": 2984,
    "fail_reasons_sum": 1280,
    "games": 4264,
    "holds": true,
    "meaning": "被 fail-closed 擋下的場次**留在分母裡當失敗**，不從母體移除。故任何閘門只能壓低通過率、不可能抬高；「排太多」的後果是低報而非高報，「排太少」才會高報。"
  },
  "gates": {
    "ledger_desync": {
      "ablation": null,
      "blocked": 1,
      "blocked_share_of_population": 0.0002,
      "delta_upper_bound": 1,
      "delta_upper_bound_share": 0.0002,
      "kind": "gate",
      "why_no_ablation": "同型：帳本重建的壘上棒次槽與 livelog 觀測的壘況不一致。消融要能繼續，必須以觀測壘況重建帳本並替憑空出現的跑者指定**責任投手與上壘手段**（earned_ok），兩者都是 9.16 的核心判定、都只能猜。這是補猜測不是移除檢查。故給確定上界：Δ ≤ 被擋場數。"
    },
    "mismatch:attribution_boundary": {
      "ablation": null,
      "blocked": 30,
      "blocked_share_of_population": 0.007,
      "delta_upper_bound": 0,
      "delta_upper_bound_share": 0.0,
      "kind": "mismatch_classification",
      "why_no_ablation": "同上，不是閘門而是對帳失敗的成因分類（淨差為 0 但逐投手歸屬不同）。Δ 恆為 0。"
    },
    "mismatch:earned_rule_boundary": {
      "ablation": null,
      "blocked": 783,
      "blocked_share_of_population": 0.1836,
      "delta_upper_bound": 0,
      "delta_upper_bound_share": 0.0,
      "kind": "mismatch_classification",
      "why_no_ablation": "同上，不是閘門。這是本卡真正的殘差：失分與出局全對、只有自責分不同，即 9.16 的記錄員判斷邊界。Δ 恆為 0。"
    },
    "mismatch:source_gap": {
      "ablation": null,
      "blocked": 141,
      "blocked_share_of_population": 0.0331,
      "delta_upper_bound": 0,
      "delta_upper_bound_share": 0.0,
      "kind": "mismatch_classification",
      "why_no_ablation": "不是 fail-closed 閘門。`mismatch:*` 是**對帳失敗後**的成因分類：重建已完整跑完、三維與官方比對不符，場次留在分母裡當失敗（見分母不變量）。沒有可以「拿掉」的檢查——拿掉標籤不會讓任何一場變成通過，Δ 恆為 0。成因為某一側 runs 或 outs 淨差不為 0，屬來源資料缺漏。"
    },
    "multiple_new_runners": {
      "ablation": null,
      "blocked": 4,
      "blocked_share_of_population": 0.0009,
      "delta_upper_bound": 4,
      "delta_upper_bound_share": 0.0009,
      "kind": "gate",
      "why_no_ablation": "拿掉它不是「移除檢查」而是「補一個猜測」。該閘門觸發於：下一個 island 的壘況比本 island 多出**一個以上**新棒次槽，即無法判斷哪一位是打者、哪一位是本來就在壘上而帳本漏掉的人。任何消融實作都必須先指定「哪一個新槽是打者」，那正是 fail-closed 要禁止的歸屬猜測；若改成不指定（batter_slot=None），多出來的跑者會在下一個 island 觸發 ledger_desync，Δ 由建構方式決定而非由資料決定，是**沒有鑑別力的假消融**。故給確定上界：Δ ≤ 被擋場數。"
    },
